# cn-printer — Paperless-ngx hand-off (copy to paperless.env, gitignored).
# Installed by Kauket as its own secret so the stack's main .env stays untouched:
#   kauket add printer.cn_printer_paperless_env ./paperless.env --dest /home/gonzalo/cn-printer/paperless.env --mode 0600
#   (host) kauket get printer.cn_printer_paperless_env && docker compose up -d --force-recreate --no-deps paperless-forwarder
# Only the paperless-forwarder service reads this file (env_file). Comments on their own lines.

# Canonical URL; printer.lan resolves it to kaiser (pfSense/Technitium split
# horizon) and the forwarder trusts step-ca via certs/root_ca.crt.
PAPERLESS_URL=https://docs.lab.gn.al
# API token of Paperless's `scanner` user (printed once by cn-paperless
# scripts/bootstrap.py). Empty or missing file = the forwarder idles and scans
# wait in /srv/scans/inbox.
PAPERLESS_TOKEN=
# Tags set on every forwarded scan (created in Paperless if missing)
PAPERLESS_TAGS=scanned
# Days a consumed scan stays in /srv/scans/processed before the janitor deletes it
PROCESSED_RETENTION_DAYS=30
